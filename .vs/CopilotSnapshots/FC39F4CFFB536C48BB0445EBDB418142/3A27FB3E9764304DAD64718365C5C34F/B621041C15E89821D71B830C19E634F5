    public class Libro
    {
        public int Id { get; set; }
        public string Titulo { get; set; }
        public string Codigo { get; set; }
        public decimal Precio { get; set; }
        public int Stock { get; set; }
    }


    public class ConexionBD
    {
        private readonly string cadenaConexion =
            @"Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=SBLI;Integrated Security=True";

        public SqlConnection ObtenerConexion()
        {
            return new SqlConnection(cadenaConexion);
        }
    }


    public class LibroDAO
    {
        private ConexionBD conexion = new ConexionBD();

        public void RegistrarLibro(Libro libro)
        {
            using (SqlConnection conn = conexion.ObtenerConexion())
            {
                conn.Open();
                string query = "INSERT INTO Libros (Titulo, Codigo, Precio, Stock) VALUES (@Titulo, @Codigo, @Precio, @Stock)";
                SqlCommand cmd = new SqlCommand(query, conn);
                cmd.Parameters.AddWithValue("@Titulo", libro.Titulo);
                cmd.Parameters.AddWithValue("@Codigo", libro.Codigo);
                cmd.Parameters.AddWithValue("@Precio", libro.Precio);
                cmd.Parameters.AddWithValue("@Stock", libro.Stock);
                cmd.ExecuteNonQuery();
            }
        }

        public List<Libro> ObtenerLibros()
        {
            List<Libro> lista = new List<Libro>();
            using (SqlConnection conn = conexion.ObtenerConexion())
            {
                conn.Open();
                string query = "SELECT Id, Titulo, Codigo, Precio, Stock FROM Libros";
                SqlCommand cmd = new SqlCommand(query, conn);
                SqlDataReader reader = cmd.ExecuteReader();
                while (reader.Read())
                {
                    lista.Add(new Libro
                    {
                        Id = reader.GetInt32(0),
                        Titulo = reader.GetString(1),
                        Codigo = reader.GetString(2),
                        Precio = reader.GetDecimal(3),
                        Stock = reader.GetInt32(4)
                    });
                }
            }
            return lista;
        }
    }

